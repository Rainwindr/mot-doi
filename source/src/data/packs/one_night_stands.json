        {
          "label": {
            "vi": "Lại gần làm quen",
            "en": "Go over and introduce"
          },
          "outcomes": [
            {
              "chance": 0.65,
              "effects": { "happy": 10, "risk": 5 },
              "setFlags": ["ons_potential"],
              "text": {
                "vi": "Cuộc trò chuyện trôi chảy và họ rõ ràng quan tâm.",
                "en": "The conversation flows and they're clearly interested."
              }
