            {
              "chance": 0.3,
              "effects": { "happy": -3 },
              "text": {
                "vi": "Họ quay đi và bạn hơi tiếc.",
                "en": "They turn away and you feel a mild regret."
              }
            }
          ]
        }
      ]
    },
